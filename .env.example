# nestwaileys session worker — environment variables
#
# LOCAL STANDALONE: run the worker on your machine outside k8s:
#   cp .env.example .env && nest start --watch --env-file .env
# Pair with mock-control.mjs (CONTROL_APP_BASE_URL below) or local teiwah-control.
#
# PROD / K8S: teiwah-control injects every var at provision time (k8s.service.ts).
# Local vs prod values and the full runbook: teiwah-control/.env.example

# HTTP port this process listens on (5335 in k3d/k8s too).
PORT=5335

# This worker's session id (e.g. brave-tiger-a1b2). Any string for local dev.
SESSION_ID=

# How this worker reaches teiwah-control (GET session config, PATCH phone).
# mock-control.mjs: http://localhost:4099
# Local teiwah-control: http://localhost:4007
# k3d: http://host.docker.internal:4007 — see teiwah-control/.env.example for tunnel/prod
CONTROL_APP_BASE_URL=http://localhost:4099

# Per-session durable storage (Baileys auth + message store). Gitignored locally.
SESSION_STORAGE_PATH=./.session-storage

# Zuplo gateway base — worker builds inbound media.url as ${base}/media/:messageId.
# Customer GETs it through Zuplo (Bearer), never the worker directly.
# Local dev: https://dev-api.teiwah.cloud (tunnel → teiwah-zuplo :9000)
# Prod: https://api.teiwah.cloud
PUBLIC_API_BASE_URL=https://dev-api.teiwah.cloud

# development enables terminal QR; production is what k8s injects into pods.
NODE_ENV=development

# Logging (see LOGGING.md). Better Stack pair is REQUIRED.
# LOG_LEVEL: fatal|error|warn|info|debug|trace (default: info)
# BETTERSTACK_INGESTING_HOST — host only, no scheme
LOG_LEVEL=info
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
