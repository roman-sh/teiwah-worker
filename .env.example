# nestwaileys session worker — environment variables
#
# This app is designed to run inside Kubernetes (one pod per session).
# teiwah-control injects all variables at provision time — you do NOT need
# a .env file for normal development (build image → k3d → dashboard).
#
# See teiwah-control/k8s.service.ts for injection values.
#
# Optional: run locally outside k8s (npm run start:dev) by exporting these
# yourself or copying to .env and using nest --env-file .env manually.

# HTTP port inside the pod (5335 in k3d)
PORT=5335

# This pod's session id (e.g. brave-tiger-a1b2) — set per deployment
SESSION_ID=

# How this pod reaches teiwah-control
# Local k3d: http://host.docker.internal:4007
CONTROL_APP_BASE_URL=
